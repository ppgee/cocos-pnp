{
  "name": "@cocos-pnp/playable-sdk",
  "version": "2.0.0-alpha.0",
  "description": "Zero-dependency lightweight unified runtime SDK for HTML5 Playable Ads across 8 major ad networks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ppgee/cocos-pnp.git",
    "directory": "packages/playable-sdk"
  },
  "homepage": "https://github.com/ppgee/cocos-pnp#readme",
  "bugs": {
    "url": "https://github.com/ppgee/cocos-pnp/issues"
  },
  "keywords": [
    "playable-ads",
    "html5-games",
    "mraid",
    "applovin",
    "unity-ads",
    "google-ads",
    "meta",
    "tiktok",
    "mintegral",
    "moloco",
    "liftoff"
  ],
  "author": "PGee",
  "license": "ISC",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
