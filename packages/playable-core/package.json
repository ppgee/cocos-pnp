{
  "name": "@ppgee/playable-core",
  "version": "2.0.0-alpha.0",
  "description": "Engine-agnostic multi-network Playable Ads packager, Base122/pako VFS builder, and offline full-asset optimizer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ppgee/cocos-pnp.git",
    "directory": "packages/playable-core"
  },
  "homepage": "https://github.com/ppgee/cocos-pnp#readme",
  "bugs": {
    "url": "https://github.com/ppgee/cocos-pnp/issues"
  },
  "keywords": [
    "playable-ads",
    "packager",
    "cocos-creator",
    "playcanvas",
    "godot",
    "unity-webgl",
    "base122",
    "optimizer"
  ],
  "author": "PGee",
  "license": "ISC",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@ppgee/playable-sdk": "workspace:*",
    "@ppgee/playable-validator": "workspace:*",
    "cheerio": "^1.0.0",
    "jszip": "^3.10.1",
    "mime-types": "^2.1.35",
    "pako": "^2.1.0"
  },
  "optionalDependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.34.0",
    "subset-font": "^2.9.0",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.3",
    "typescript": "^5.8.0"
  }
}
