{
  "name": "cocos-pnp",
  "version": "1.3.3",
  "description": "Ads Playable for Cocos",
  "main": "index.js",
  "scripts": {
    "commit": "cz",
    "build:v2": "pnpm --filter @cocos-pnp/playable-sdk build && pnpm --filter @cocos-pnp/playable-validator build && pnpm --filter @cocos-pnp/playable-core build && pnpm --filter @cocos-pnp/playable-cli build",
    "test:v2": "pnpm run build:v2 && pnpm --filter @cocos-pnp/playable-sdk test && pnpm --filter @cocos-pnp/playable-validator test && pnpm --filter @cocos-pnp/playable-core test && pnpm --filter @cocos-pnp/playable-cli test",
    "pack:check": "pnpm run build:v2 && node scripts/verify-packages.mjs",
    "build:validator": "pnpm --filter @cocos-pnp/playable-validator build && pnpm --filter @cocos-pnp/playable-cli build",
    "test:validator": "pnpm --filter @cocos-pnp/playable-validator test",
    "playable": "node packages/playable-cli/dist/cli.js",
    "test": "pnpm run test:v2"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:ppgee/cocos-pnp.git"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.js"
    }
  },
  "keywords": [
    "cocos",
    "ads-playable",
    "facebook",
    "unity",
    "google",
    "tiktok"
  ],
  "author": "ppgee",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "commitizen": "^4.2.5",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^6.9.1"
  }
}
