{
  "name": "cocos-pnp",
  "version": "1.3.3",
  "description": "Ads Playable for Cocos",
  "main": "index.js",
  "scripts": {
    "commit": "cz",
    "build:v2": "pnpm --filter @ppgee/playable-sdk build && pnpm --filter @ppgee/playable-validator build && pnpm --filter @ppgee/playable-core build && pnpm --filter @ppgee/playable-cli build",
    "test:v2": "pnpm run build:v2 && pnpm --filter @ppgee/playable-sdk test && pnpm --filter @ppgee/playable-validator test && pnpm --filter @ppgee/playable-core test && pnpm --filter @ppgee/playable-cli test",
    "pack:check": "pnpm run build:v2 && node scripts/verify-packages.mjs",
    "build:validator": "pnpm --filter @ppgee/playable-validator build && pnpm --filter @ppgee/playable-cli build",
    "test:validator": "pnpm --filter @ppgee/playable-validator test",
    "playable": "node packages/playable-cli/dist/cli.js",
    "test": "pnpm run test:v2"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:ppgee/cocos-pnp.git"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.js"
    }
  },
  "keywords": [
    "cocos",
    "ads-playable",
    "facebook",
    "unity",
    "google",
    "tiktok"
  ],
  "author": "ppgee",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "commitizen": "^4.2.5",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^6.9.1"
  },
  "pnpm": {
    "overrides": {
      "ajv@>=7 <9": "^8.18.0",
      "brace-expansion@^1": "^1.1.22",
      "brace-expansion@^2": "^2.1.8",
      "braces@^3": "^3.0.3",
      "cross-spawn@^7": "^7.0.5",
      "diff@^4": "^4.0.4",
      "follow-redirects@^1": "^1.16.3",
      "form-data@^4": "^4.0.6",
      "lodash@^4": "^4.18.1",
      "micromatch@^4": "^4.0.8",
      "minimatch@^3": "^3.1.5",
      "minimatch@^5": "^5.1.9",
      "picomatch@^2": "^2.3.2",
      "semver@^5": "^5.7.2",
      "semver@^7": "^7.5.2",
      "tmp@<0.2.7": "^0.2.7",
      "word-wrap@^1": "^1.2.4",
      "yaml@^1": "^1.10.3"
    }
  }
}
